{
  "info": {
    "_postman_id": "clinic-egypt-fhir-referral-ws",
    "name": "Clinic API - Egypt FHIR + Referral WS",
    "description": "Postman collection for FHIR endpoints and referral WebSocket integration using Egyptian sample identities and numbers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1) Auth Setup (Doctor)",
      "item": [
        {
          "name": "1.1 Register Doctor (idempotent)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register returns 200 or already-exists 400', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('doctor_token', data.token || '');",
                  "  console.log('Doctor registered:', data?.user?.email);",
                  "} else {",
                  "  console.log('Doctor already exists, continue to login.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dr.ahmed.elmasry@clinic.local\",\n  \"password\": \"DrAhmed@123\",\n  \"firstName\": \"Ahmed\",\n  \"lastName\": \"El Masry\",\n  \"phoneNumber\": \"01012345678\",\n  \"role\": \"Doctor\",\n  \"specialization\": \"Orthopedics\",\n  \"licenseNumber\": \"EG-DOC-2026-001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "1.2 Login Doctor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.environment.set('doctor_token', data.token);",
                  "pm.environment.set('current_token', data.token);",
                  "pm.environment.set('doctor_user_id', String(data?.user?.userId || ''));",
                  "pm.test('Token present', function () {",
                  "  pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dr.ahmed.elmasry@clinic.local\",\n  \"password\": \"DrAhmed@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "1.3 Doctor Profile (extract doctor_id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile loaded', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.environment.set('doctor_id', String(data.doctorId));",
                  "pm.test('doctorId exists', function () {",
                  "  pm.expect(data.doctorId).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{current_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "doctors",
                "profile"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2) Referral + WebSocket Connectivity",
      "item": [
        {
          "name": "2.1 Create Referral (Egypt sample)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Referral created', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.environment.set('referral_id', String(data.referralId));",
                  "pm.environment.set('patient_external_id', data.patientExternalId || pm.environment.get('patient_external_id'));",
                  "pm.test('Referral ID extracted', function () {",
                  "  pm.expect(data.referralId).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{current_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientExternalId\": \"{{patient_external_id}}\",\n  \"patientPhone\": \"01098765432\",\n  \"doctorId\": {{doctor_id}},\n  \"referralType\": \"Physiotherapy\",\n  \"reason\": \"Post-operative rehabilitation after ACL surgery\",\n  \"diagnosis\": \"ACL reconstruction follow-up with limited knee range of motion\",\n  \"recommendedTreatment\": \"12 sessions of supervised physiotherapy + home exercise plan\",\n  \"priority\": \"High\",\n  \"doctorNotes\": \"Patient: Mahmoud Hassan, age 32, from Giza. Start within 48 hours.\",\n  \"externalReferralId\": \"EG-REF-2026-1001\",\n  \"autoSend\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/referrals",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "referrals"
              ]
            }
          }
        },
        {
          "name": "2.2 Send Referral (tests WS integration)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Send endpoint responds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 500]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('external_referral_id', data.externalReferralId || '');",
                  "  pm.environment.set('ws_connection_ok', 'true');",
                  "  pm.test('WS path succeeded via API', function () {",
                  "    pm.expect(data.status).to.be.oneOf(['Sent', 'Accepted', 'InProgress', 'Completed']);",
                  "  });",
                  "} else {",
                  "  pm.environment.set('ws_connection_ok', 'false');",
                  "  console.log('WS integration failed. Ensure Python WS server is running at configured endpoint.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{current_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/referrals/{{referral_id}}/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "referrals",
                "{{referral_id}}",
                "send"
              ]
            }
          }
        },
        {
          "name": "2.3 Get Referral by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Referral fetched', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Referral matches id', function () {",
                  "  pm.expect(String(data.referralId)).to.eql(pm.environment.get('referral_id'));",
                  "});",
                  "pm.test('Referral has patient and doctor values', function () {",
                  "  pm.expect(data.patientExternalId).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.doctorId).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{current_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/referrals/{{referral_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "referrals",
                "{{referral_id}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3) FHIR Endpoints",
      "item": [
        {
          "name": "3.1 FHIR Metadata",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Metadata available', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Capability-like payload contains rest', function () {",
                  "  pm.expect(data).to.have.property('rest');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/fhir/metadata",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "fhir",
                "metadata"
              ]
            }
          }
        },
        {
          "name": "3.2 FHIR Patient Search by Identifier",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('FHIR Patient search responds 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('FHIR bundle-style fields exist', function () {",
                  "  pm.expect(data).to.have.property('total');",
                  "  pm.expect(data).to.have.property('entry');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{current_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/fhir/Patient?identifier={{patient_external_id}}&name=Mahmoud",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "fhir",
                "Patient"
              ],
              "query": [
                {
                  "key": "identifier",
                  "value": "{{patient_external_id}}"
                },
                {
                  "key": "name",
                  "value": "Mahmoud"
                }
              ]
            }
          }
        },
        {
          "name": "3.3 FHIR Practitioner Search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('FHIR Practitioner search responds 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Bundle keys exist', function () {",
                  "  pm.expect(data).to.have.property('total');",
                  "  pm.expect(data).to.have.property('entry');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{current_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/fhir/Practitioner?name=Ahmed&specialization=Orthopedics",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "fhir",
                "Practitioner"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "Ahmed"
                },
                {
                  "key": "specialization",
                  "value": "Orthopedics"
                }
              ]
            }
          }
        },
        {
          "name": "3.4 FHIR ServiceRequest by Referral ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('FHIR ServiceRequest by id responds', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{current_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/fhir/ServiceRequest/{{referral_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "fhir",
                "ServiceRequest",
                "{{referral_id}}"
              ]
            }
          }
        },
        {
          "name": "3.5 FHIR ServiceRequest Search by Practitioner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('FHIR ServiceRequest search responds 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Bundle response shape', function () {",
                  "  pm.expect(data).to.have.property('total');",
                  "  pm.expect(data).to.have.property('entry');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{current_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/fhir/ServiceRequest?practitioner={{doctor_id}}&status=active",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "fhir",
                "ServiceRequest"
              ],
              "query": [
                {
                  "key": "practitioner",
                  "value": "{{doctor_id}}"
                },
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            }
          }
        },
        {
          "name": "3.6 FHIR Observation Search by Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('FHIR Observation search responds 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const data = pm.response.json();",
                  "pm.test('Observation bundle shape', function () {",
                  "  pm.expect(data).to.have.property('total');",
                  "  pm.expect(data).to.have.property('entry');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{current_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/fhir/Observation?patient={{patient_external_id}}&category=vital-signs",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "fhir",
                "Observation"
              ],
              "query": [
                {
                  "key": "patient",
                  "value": "{{patient_external_id}}"
                },
                {
                  "key": "category",
                  "value": "vital-signs"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
