{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=clinic_dev.db"
  },

  "Database": {
    "AutoInitialize": false
  },

  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!!",
    "ExpirationMinutes": 120,
    "Issuer": "ClinicAPI",
    "Audience": "ClinicApp"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "Fhir": {
    "BaseUrl": "https://api.clinic-system.com/fhir",
    "Version": "4.0.1",
    "Format": "json",
    "Publisher": "Clinic Management System"
  },

  "ExternalServices": {
    "PhysiotherapyApi": {
      "BaseUrl": "http://localhost:5001",
      "ApiKey": "your-api-key-here"
    }
  },

  "ReferralWebSocket": {
    "EndpointUrl": "ws://127.0.0.1:8000/ws/referrals?token=<VALID_PYTHON_JWT_TOKEN_HERE>",
    "JwtToken": "",
    "JwtTokenFilePath": "",
    "ClientCertificatePath": "",
    "ClientCertificatePassword": "",
    "SourceSystem": "dotnet-system",
    "HeartbeatIntervalSeconds": 30,
    "AcknowledgementTimeoutSeconds": 5,
    "MaxSendAttempts": 3,
    "InitialReconnectDelaySeconds": 2,
    "MaxReconnectDelaySeconds": 30
  },

  "AllowedHosts": "*"
}
